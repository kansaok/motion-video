# motion-mcp — salin jadi .env.mcp (tidak di-commit).

# URL publik server ini, dipakai untuk tautan unduh MP4 (tanpa garis miring di akhir).
PUBLIC_URL=https://motion.bi1mp.id

# API bimp untuk verifikasi token langganan (POST {BIMP_API_URL}/internal/motion-mcp/verify).
BIMP_API_URL=https://api.bi1mp.id/api
# Harus sama dengan MOTION_MCP_SERVICE_KEY di .env API bimp. Buat: openssl rand -hex 32
BIMP_SERVICE_KEY=

# Kunci HMAC tautan unduh. Buat: openssl rand -hex 32
UNDUH_RAHASIA=

# Render: tab Chromium per render, render bersamaan, viewport (turunkan kalau "Target crashed").
WORKERS=4
RENDER_PARALEL=1
MOTION_VIEWPORT=1400x1600

# Batas per akun
MAKS_PROYEK=20
MAKS_DETIK=180
MAKS_UNDUH_MB=50
RETENSI_HARI=14

# Hanya untuk uji lokal TANPA bimp: token ini diterima sebagai user 0. Kosongkan di produksi.
MCP_DEV_TOKEN=
