# motion-mcp — salin jadi .env.mcp (tidak di-commit).

# URL publik server ini, dipakai untuk tautan unduh MP4 (tanpa garis miring di akhir).
PUBLIC_URL=https://motion.bi1mp.id

# API bimp untuk verifikasi token langganan (POST {BIMP_API_URL}/internal/motion-mcp/verify).
BIMP_API_URL=https://api.bi1mp.id/api
# Harus sama dengan MOTION_MCP_SERVICE_KEY di .env API bimp. Buat: openssl rand -hex 32
BIMP_SERVICE_KEY=

# Kunci HMAC tautan unduh, minimal 32 karakter. Buat: openssl rand -hex 32
UNDUH_RAHASIA=

# Render: tab Chromium per render, render bersamaan, viewport (turunkan kalau "Target crashed").
WORKERS=4
RENDER_PARALEL=1
MOTION_VIEWPORT=1400x1600
# Batas total render; kosong = max(10, MAKS_DETIK / 6) menit. Watchdog hanya aktif saat render frame.
RENDER_BATAS_MENIT=
RENDER_BATAS_MACET_DETIK=120
ANTRE_MAKS=20

# Batas per akun
MAKS_PROYEK=20
MAKS_DETIK=180
MAKS_UNDUH_MB=50
MAKS_EKSTRAK_MB=300
KUOTA_MB=1500
RETENSI_HARI=14

# /siap (dan HEALTHCHECK /sehat) menjawab 503 dan render baru ditolak bila ruang bebas DATA
# di bawah ini. Satu render 180 dtk menulis ±2-3 GB frame sementara.
MIN_DISK_MB=4096

# Hanya untuk uji lokal TANPA bimp: token ini diterima sebagai user 0. Kosongkan di produksi.
MCP_DEV_TOKEN=

# Dasbor admin /admin (HTTP Basic, sandi = token ini): antrean, riwayat, disk per akun, batalkan render.
# Kosong = /admin tidak ada (404). Bila diisi minimal 32 karakter. Buat: openssl rand -hex 32
ADMIN_TOKEN=

# Kunci ElevenLabs milik pelanggan (alat kunci_elevenlabs / buat_vo) dienkripsi dengan rahasia ini.
# Kosong = fitur mati. Bila diisi minimal 32 karakter: openssl rand -hex 32. Merotasinya membuat
# kunci tersimpan tidak terbaca; pelanggan perlu menyimpan ulang (pesan galatnya menyebut itu).
KUNCI_ENKRIPSI=
